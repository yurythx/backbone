# Django Settings
DEBUG=True
# SECURITY WARNING: Generate a secure secret key for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Or: docker compose exec backend python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-local-dev-key-CHANGE-THIS-IN-PRODUCTION
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blackbone_db

# Redis (Cache & Channels)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=blackbone-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
