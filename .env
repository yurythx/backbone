# Configurações de Produção do Backbone
# --- Geral ---
DEBUG=False
# Chave gerada aleatoriamente para segurança
SECRET_KEY=django-insecure-prod-key-change-this-in-real-production-environment-98s7df987s9d8f7
ALLOWED_HOSTS=api.backbone.projetoravenna.cloud,backbone.projetoravenna.cloud,192.168.1.121,localhost,127.0.0.1

# --- Banco de Dados (Postgres) ---
POSTGRES_DB=backbone_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/backbone_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Armazenamento (MinIO) ---
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=backbone-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# --- CORS & Segurança ---
CORS_ALLOWED_ORIGINS=https://backbone.projetoravenna.cloud,http://192.168.1.121:3005,http://localhost:3005,http://localhost:8005
CSRF_TRUSTED_ORIGINS=https://backbone.projetoravenna.cloud,https://api.backbone.projetoravenna.cloud,http://192.168.1.121:3005,http://192.168.1.121:8005,http://localhost:3005,http://localhost:8005

# --- Frontend ---
# URL pública da API usada pelo navegador do cliente
NEXT_PUBLIC_API_URL=https://api.backbone.projetoravenna.cloud
# URL interna usada pelo Next.js SSR (opcional, se precisar de rota direta)
# API_URL_INTERNAL=http://backend:8005

FRONTEND_URL=https://backbone.projetoravenna.cloud

# --- Email (SMTP) ---
# Preencha com seus dados reais se tiver, senão deixe console/localhost
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=suporte@backbone.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_aqui
DEFAULT_FROM_EMAIL=Backbone <no-reply@backbone.projetoravenna.cloud>

# --- Web Push (VAPID) ---
# Chaves de exemplo geradas (substitua por definitivas se desejar persistência real)
VAPID_PUBLIC_KEY=BMk_D9xG2J7xG5xG2J7xG5xG2J7xG5xG2J7xG5xG2J7xG5xG2J7xG5xG2J7xG5
VAPID_PRIVATE_KEY=your_private_key_here_generated_by_pywebpush
VAPID_ADMIN_EMAIL=admin@backbone.projetoravenna.cloud
